# Copy this file to .env and keep real credentials out of this template.
# The cron job sources .env with /bin/sh, so use shell-compatible KEY=value lines.

# Gemini: required by `generate` and `evaluate-model`; not needed by `publish`.
GEMINI_API_KEY=

# Optional same-article discovery and Reuters recovery after blocked source retrieval.
# If unset, this fallback is skipped and the rest of generation continues.
TAVILY_API_KEY=

# Optional Jina Reader: anonymous first; retry HTTP 401/429 once with this key.
JINA_API_KEY=

# Optional Adobe PDF-to-Markdown extraction. Set both values to enable it.
# If either value is missing or Adobe fails, PDF extraction falls back to local pypdf.
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# Optional fixed model overrides. These defaults are used when the variables are unset.
DAILY_BRIEF_GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
DAILY_BRIEF_GEMINI_SUMMARIZER_MODEL=gemini-3.6-flash
# Ordered summary fallbacks; empty disables. If unset, these defaults apply
# only to the default 3.6 primary. Custom primaries default to no fallbacks.
DAILY_BRIEF_GEMINI_SUMMARIZER_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.8-flash

# Minimum spacing between HTTP attempts for each configured model, including
# retries. These defaults target about 10 RPM for the 15 RPM classifier quota
# and 3 RPM for the 5 RPM summarizer quota.
# Summary spacing is also shared across primary/fallback switches.
DAILY_BRIEF_GEMINI_CLASSIFIER_MIN_REQUEST_INTERVAL_SECONDS=6
DAILY_BRIEF_GEMINI_SUMMARIZER_MIN_REQUEST_INTERVAL_SECONDS=20

# Publishing: both values are required by `publish`; neither is needed by `generate`.
DAILY_BRIEF_PUBLISH_URL=
DAILY_BRIEF_PUBLISH_TOKEN=
