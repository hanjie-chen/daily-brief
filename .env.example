# Required
GEMINI_API_KEY=

# Optional: defaults to gemini-3.5-flash-lite
DAILY_BRIEF_GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
DAILY_BRIEF_GEMINI_SUMMARIZER_MODEL=gemini-3.5-flash-lite

# Optional: enables bounded Reuters syndicated-copy discovery after DataDome/Jina failure
TAVILY_API_KEY=

# Required only for publishing
DAILY_BRIEF_PUBLISH_URL=
DAILY_BRIEF_PUBLISH_TOKEN=
