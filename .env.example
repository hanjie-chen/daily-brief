# Copy this file to .env and fill in the credentials you need.
# Keep credentials out of Git. Use shell-compatible KEY=value syntax.
# The CLI reads environment variables; it does not load .env automatically.

# ------------------------------------------------------------
# 1. Model service
# ------------------------------------------------------------
# Choose openrouter or gemini.
# Fill in only the API key for the selected service.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------
# 2. Website publishing
# ------------------------------------------------------------
# Both values are required for publishing.
# Leave blank if you only generate briefs locally.
PUBLISH_URL=
PUBLISH_TOKEN=

# ------------------------------------------------------------
# 3. Optional material retrieval services
# ------------------------------------------------------------

# Jina Reader
# Anonymous access is tried first. This key enables one retry
# when Reader returns HTTP 401 or 429.
JINA_API_KEY=

# Tavily
# Search for verified copies or same-event reporting when the
# original page cannot be retrieved. Leave blank to skip this step.
TAVILY_API_KEY=

# Adobe PDF Services
# Set both values to enable PDF-to-Markdown conversion.
# Missing credentials or conversion failures use local extraction.
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# ------------------------------------------------------------
# 4. Advanced settings: OpenRouter
# ------------------------------------------------------------
# Usually no changes are needed.
# Uncomment a setting to override its default value.
# These settings apply only when LLM_PROVIDER=openrouter.

# Models
# Classification disables reasoning; summaries use medium reasoning.
# Requests may switch providers for the same model, but not models.
# OPENROUTER_CLASSIFIER_MODEL=qwen/qwen3.8-flash
# OPENROUTER_SUMMARIZER_MODEL=openai/gpt-6-luna

# Timeout per HTTP attempt, in seconds.
# OPENROUTER_TIMEOUT_SECONDS=90

# Maximum additional attempts after a transient failure.
# OPENROUTER_MAX_RETRIES=2

# Minimum seconds between request starts, including retries.
# OPENROUTER_CLASSIFIER_INTERVAL_SECONDS=1
# OPENROUTER_SUMMARIZER_INTERVAL_SECONDS=1

# ------------------------------------------------------------
# 5. Advanced settings: Gemini
# ------------------------------------------------------------
# Usually no changes are needed.
# Uncomment a setting to override its default value.
# These settings apply only when LLM_PROVIDER=gemini.

# Models
# GEMINI_CLASSIFIER_MODEL=gemini-3.5-flash-lite
# GEMINI_SUMMARIZER_MODEL=gemini-3.6-flash

# Summary fallback models, tried in the listed order.
# Set an empty value to disable fallback.
# These defaults apply only to the default primary model.
# Custom primary models require an explicit fallback list.
# Model evaluation disables fallback.
# GEMINI_SUMMARIZER_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.8-flash

# Minimum seconds between request starts, including retries.
# Summary spacing also applies when switching fallback models.
# GEMINI_CLASSIFIER_INTERVAL_SECONDS=6
# GEMINI_SUMMARIZER_INTERVAL_SECONDS=20